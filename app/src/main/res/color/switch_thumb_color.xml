<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Use theme-aware on-surface so thumb is black (light) / white (dark) -->
    <item android:color="?attr/colorOnSurface" android:state_checked="true" />
    <item android:color="?attr/colorOnSurface" android:state_activated="true" />
    <!-- Unchecked thumb: still monochrome, but softer (avoid theme outline colors). -->
    <item android:alpha="0.45" android:color="?attr/colorOnSurface" />
</selector> 